---
import BaseHead from "@/components/BaseHead.astro";
import { activeTheme } from "@/lib/site";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

const { title, description, canonical } = Astro.props;
const themeVars = Object.entries(activeTheme.vars)
  .map(([key, value]) => `${key}: ${value};`)
  .join(" ");
---
<html lang="zh-Hant">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");
    </style>
  </head>
  <body style={themeVars}>
    <Nav />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
